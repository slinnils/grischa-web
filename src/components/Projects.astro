---
import { projects } from "../data/projects.js";
---

<section id="projects">
  <h1 class="section-title">Mein erstes Projekt</h1>

  <div class="projects-container">
    {
      projects.map((project) => (
        <div class="project-wrapper card">
          <div class="group">
            <h3 class="card-title project-title">
              <a href={`/${project.slug}`}>{project.title}</a>
            </h3>
            <img src={project.mockup.src} />
          </div>
          <div class="text">
            <p class="description">{project.description}</p>
            <div class="link-group">
              <a class="project-link" href={`/${project.slug}`}>
                zu den Projekt Details
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    max-width: 100%;
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .projects-container{
    display: flex;
    flex-direction: column;
    gap: 2rem;
    outline: red;
  }

  @media (min-width: 769px) {
    .project-wrapper {
      display: grid;
      grid-template-columns: minmax(400px, 688px) minmax(250px, 769px);
      gap: 1.5rem;
      align-items: center;
    }
  }

  .description,
  .project-link {
    font-size: clamp(0.9rem, 2vw, 1.2rem);
  }

  .project-link {
    color: var(--color-gw-accent);
    cursor: pointer;
    border-bottom: 1px solid var(--color-gw-accent);
  }
</style>
