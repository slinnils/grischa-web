---
import Carousel from "../components/Carousel.jsx";
import { projects } from "../data/projects.js";
---

<section id="projects">
  <h2>Mein Projekt</h2>

  {
    projects.map((project) => (
      <div class="project-wrapper">
        <div class="group">
          <h3>
            <a href="/piz-patty">{project.title}</a>
          </h3>

          <Carousel images={project.images} client:visible />
        </div>
        <div class="text">
          <p>
            {project.description}
          </p>
          <a class="project-link" href={`/${project.slug}`}>
            zu den Projekt Details
          </a>
        </div>
      </div>
    ))
  }
</section>

<style>
  section {
    max-width: 100%;
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .project-wrapper {
    margin: 2rem auto;
    width: 100%;

    display: flex;
    flex-direction: column;
  }

  @media (min-width: 769px) {
    .project-wrapper {
      margin: 2rem 0;
      flex-direction: row;
      display: grid;
      grid-template-columns: minmax(400px, 688px) minmax(333px, 769px);

      align-items: center;
    }
  }

  h3 {
    font-size: 1.5rem;
    color: var(--color-gw-text-bright);
  }

  .project-link {
    color: var(--color-gw-accent);
    cursor: pointer;
    border-bottom: 1px solid var(--color-gw-accent);
  }
</style>
