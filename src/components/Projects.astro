---
import Carousel from "../components/Carousel.jsx";
import { projects } from "../data/projects.js";
---

<section id="projects">
  <h1 class="section-title">Mein Projekt</h1>

  {
    projects.map((project) => (
      <div class="project-wrapper card">
        <div class="group">
          <h3 class="card-title">
            <a href={`/${project.slug}`}>{project.title}</a>
          </h3>

          <Carousel images={project.images} client:visible />
        </div>
        <div class="text">
          <p class="description">{project.description}</p>
          <a class="project-link" href={`/${project.slug}`}>
            zu den Projekt Details
          </a>
        </div>
      </div>
    ))
  }
</section>

<style>
  section {
    max-width: 100%;
  }
  .group {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 769px) {
    .project-wrapper {
      margin: 2rem 0;
      flex-direction: row;
      display: grid;
      grid-template-columns: minmax(400px, 688px) minmax(333px, 769px);

      align-items: center;
    }
  }

  .description,
  .project-link {
    font-size: clamp(0.8rem, 4vw, 1.2rem);
  }

  .project-link {
    color: var(--color-gw-accent);
    cursor: pointer;
    border-bottom: 1px solid var(--color-gw-accent);
  }
</style>
