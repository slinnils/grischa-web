---

---

<section id="hero-wrapper">
  <p>Webentwicklung aus Graubünden</p>
  <h1>
    Ihre Website.<br />Professionell.<span class="text-gw-accent"> Modern.</span>
    Schnell.
  </h1>
  <p>
    Ich helfe kleinen und mittelgrossen Betrieben zu einem überzeugenden
    Internetauftritt, damit Ihre Online-Präsenz Ihre Arbeit widerspiegelt.
  </p>
  <div class="btn-group">
    <a href="#projects" class="btn-primary">Projekte ansehen</a>
    <a href="#contact" class="btn-secondary">Kontakt aufnehmen</a>
  </div>
</section>

<script>
  const hero = document.querySelector("#hero-wrapper");
  function updateParallax() {
    hero.style.backgroundPositionY = `calc(50% + ${window.scrollY * 0.4}px)`;
  }
  updateParallax();
  window.addEventListener("scroll", updateParallax);
</script>

<style>
  section {
    background-color: var(--color-gw-bg-card);

    padding: 0 1.25rem 5rem 1.25rem;
    position: absolute;
    top: 0;
    left: 0;

    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: end;
  }

  h1{
    font-size: clamp(1rem, 6vw, 2.3rem);
    color: var(--color-gw-text-bright);
  }

  p {
    font-size: clamp(0.8rem, 4vw, 1.5rem);
  }

  section {
    background: url("../assets/hero-view-mobile.jpg");
    background-size: cover;
    background-position: right center;
    height: 80%;
  }

  @media (min-width: 769px) {
    section {
      background: url("../assets/hero-view.jpg");
      background-size: cover;
      padding: 0 5rem 5rem 5rem;
      background-position: right center;
    }
  }

  section::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(to bottom, transparent, var(--color-gw-bg));
    pointer-events: none;
  }

  h1,
  .hero-text,
  section p {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .btn-group {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 769px) {
    .btn-group {
      flex-direction: row;
      height: 60px;
    }
  }
</style>
