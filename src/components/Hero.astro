---

---

<section id="hero-wrapper">
  <div class="content">
    <p>Webentwicklung aus Graubünden</p>
    <h1>
      Ihre Website.<br />Professionell.<span class="hero-span"> Modern.</span>
      Schnell.
    </h1>
    <p>
      Ich helfe kleinen und mittelgrossen Betrieben zu einem überzeugenden
      Internetauftritt, damit Ihre Online-Präsenz Ihre Arbeit widerspiegelt.
    </p>
    <div class="btn-group">
      <a href="#projects" class="btn-primary">Projekte ansehen</a>
      <a href="#contact" class="btn-secondary">Kontakt aufnehmen</a>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector("#hero-wrapper");
  function updateParallax() {
    hero.style.backgroundPositionY = `calc(50% + ${window.scrollY * 0.4}px)`;
  }
  updateParallax();
  window.addEventListener("scroll", updateParallax);
</script>

<style>
  section {
    background: url("../assets/hero-view.jpg");
    background-size: cover;
    background-position: right center;
    height: 80%;
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    padding: 0 2rem 5rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: end;
    width: 100%;
    max-width: 2200px;
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(1rem, 6vw, 2.3rem);
    color: var(--color-gw-text-bright);
  }

  p {
    font-size: clamp(0.8rem, 4vw, 1.5rem);
  }

  @media (min-width: 1746px) {
    section {
      background-size: contain;
    }
  }

  @media (min-width: 769px) {
    section {
      background: url("../assets/hero-view.jpg");
      background-size: cover;
      padding: 0 5rem 5rem 5rem;
      background-position: right center;
    }
  }

  section::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(to bottom, transparent, var(--color-gw-bg));
    pointer-events: none;
  }

  h1,
  .hero-text,
  section p {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .btn-group {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 769px) {
    .btn-group {
      flex-direction: row;
      height: 60px;
    }
  }
</style>
