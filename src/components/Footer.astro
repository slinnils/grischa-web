<div class="footer-container">
  <hr />
  <div class="container">
    <div class="links">
      <a href="/">Home</a>
      <a href="/impressum">Impressum</a>
      <a href="/#contact">Kontakt</a>
    </div>

    <section>
      <h2>E-Mail-Addresse:</h2>
      <a class="mail" href="mailto:info@grischa-web.ch">info@grischa-web.ch</a
      >
      <h3>Telefonnummer:</h3>
      <a class="tel" href="tel:+41799689805">+41 79 968 98 05</a>
    </section>
  </div>

  <p class="copyright">© 2026 Grischa-Web. All rights reserved.</p>
</div>

<style>
  .footer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 0 1rem;
    margin-top: 3rem;
  }

  .container {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  a:not(.mail, .tel) {
    color: var(--color-gw-text-bright);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    cursor: pointer;
  }

  a:not(.mail, .tel):hover {
    color: var(--color-gw-text-mute);
  }

  h2, h3 {
    color: var(--color-gw-accent);
    font-size: 1.5rem;
  }

  @media (min-width: 800px) {
    .container {
      flex-direction: row;
      gap: 8rem;
    }
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-right: 3rem;
  }

  .mail, .tel {
    color: var(--color-gw-text-mute);
    font-size: clamp(1rem, 3vw, 1.3rem);
  }

  h3{
    margin-top: 1rem;
  }

  .copyright {
    color: var(--color-gw-text-mute);
    margin-bottom: 0.2rem;
  }

  a:hover {
    color: var(--color-gw-text-bright);
  }
</style>
