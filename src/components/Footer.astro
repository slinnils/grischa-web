<div class="footer-container">
  <hr />
  <div class="container">
    <div class="links">
      <a href="/">Home</a>
      <a href="/impressum">Impressum</a>
      <a href="/#contact">Kontakt</a>
    </div>

    <section>
      <h2>Email Addresse:</h2>
      <a class="mail" href="mailto:grischaweb@proton.me">grischaweb@proton.me</a
      >
    </section>
  </div>

  <p class="copyright">© 2026 Grischa-Web. All rights reserved.</p>
</div>

<style>
  .footer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 0 1rem;
    margin-top: 3rem;
  }

  .container {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  a:not(.mail) {
    color: var(--color-gw-text-bright);
    font-size: 1.2rem;
    cursor: pointer;
  }

  a:not(.mail):hover {
    color: var(--color-gw-text-mute);
  }

  h2 {
    color: var(--color-gw-accent);
    font-size: 1.3rem;
  }

  @media (min-width: 800px) {
    .container {
      flex-direction: row;
      gap: 8rem;
    }
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mail {
    color: var(--color-gw-text-mute);
  }

  .copyright {
    color: var(--color-gw-text-mute);
    margin-bottom: 0.2rem;
  }

  a:hover {
    color: var(--color-gw-text-bright);
  }
</style>
