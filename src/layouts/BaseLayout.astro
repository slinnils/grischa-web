---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "Grischa Web - Webdesign aus Graubünden" } = Astro.props;
---

<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Professionelles Webdesign für KMU und Selbständige in Graubünden. Moderne, schnelle und suchmaschinenoptimierte Websites."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?&family=Changa+One:ital@0;1&family=Nova+Square&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.png" />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
  </body>

  <style>
    body {
      padding: 0 0.8rem;
    }

    @media(min-width: 1746px){
      body{
        margin: 0 auto;
        max-width: 2200px;
      }
    }

    @media (min-width: 800px) {
      body {
        padding: 0 2.5rem;
      }
    }
  </style>
</html>
